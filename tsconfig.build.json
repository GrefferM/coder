{
  // The main process as `npm run build:mac` compiles it: everything the root config covers but the specs and their stand-ins.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "sourceMap": false
  },
  "exclude": ["node_modules", "dist", "tests", "src/app/renderer", "src/**/*.spec.ts", "src/**/testing/**"]
}
