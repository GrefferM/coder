{
  "name": "coder",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop canvas where agents are placed, linked and run as a graph",
  "author": "Mykhailo Biloshkurskyi <zmishabelijj@gmail.com> (https://www.linkedin.com/in/mykhailo-biloshkurskyi/)",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "main": "src/app/bootstrap.js",
  "scripts": {
    "dev:app": "node scripts/dev-app.js",
    "agent": "./node_modules/.bin/electron src/app/agent-bootstrap.js",
    "dev:app:watch": "nodemon --watch src/app --watch src/modules --watch src/contracts --watch src/utils --ext ts,tsx,mts,js,scss,html --ignore src/app/renderer --ignore \"**/*.spec.ts\" --exec \"node scripts/dev-app.js\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/app/renderer && tsc --noEmit -p tests",
    "test:back": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron --require reflect-metadata --require ts-node/register --test \"src/{!(app),app/!(renderer)}/**/*.spec.ts\" \"tests/**/*.e2e.ts\"",
    "test:front": "vitest run --config src/app/renderer/vite.config.mts",
    "graph:features": "node scripts/feature-graph.js",
    "migration:generate": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/run-migration-cli.js migration:generate -d src/modules/data-source-cli.ts",
    "migration:run": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/run-migration-cli.js migration:run -d src/modules/data-source-cli.ts",
    "migration:revert": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/run-migration-cli.js migration:revert -d src/modules/data-source-cli.ts",
    "lint": "eslint . && node scripts/feature-graph.js",
    "prettier": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@langchain/anthropic": "^1.5.6",
    "@langchain/core": "^1.2.8",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.8",
    "@langchain/openrouter": "^0.4.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1",
    "bootstrap": "^5.3.8",
    "class-validator": "^0.15.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "sass": "^1.102.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
