{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "rootDir": "..",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.tsbuildinfo"
  },
  // Tests import from ../src, so both trees are in scope; otherwise tsc (and an IDE) reports every import into src as
  // a rootDir violation (TS6059).
  "include": ["**/*.ts", "../src/**/*.ts"],
  "exclude": ["../node_modules", "../src/modules/electron-app/renderer", "../src/app/renderer"]
}
